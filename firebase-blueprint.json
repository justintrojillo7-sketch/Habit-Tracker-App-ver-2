{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "User preferences, Week A/B anchor configuration, school holidays, and category colour settings.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "theme": { "type": "string", "enum": ["system", "light", "dark"] },
        "weekAnchorMonday": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "weekAnchorType": { "type": "string", "enum": ["A", "B"] },
        "weekOverrides": { "type": "object" },
        "schoolHolidays": { "type": "array" },
        "targetBedtime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "notificationsEnabled": { "type": "boolean" },
        "reminderOptions": { "type": "object" },
        "categoryColours": { "type": "object" },
        "schemaVersion": { "type": "number" },
        "migrationMeta": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "theme", "weekAnchorMonday", "weekAnchorType", "targetBedtime", "notificationsEnabled", "updatedAt"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Recurring or one-off calendar event with Week A/B, commitment status, and per-occurrence exceptions.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "enum": ["teaching", "behold", "fitness", "faith", "personal", "rest"] },
        "subcategory": { "type": "string", "minLength": 1, "maxLength": 80 },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "endDate": { "type": "string", "maxLength": 10 },
        "startTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "endTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "recurrence": { "type": "string", "enum": ["once", "daily", "weekly", "fortnightly", "monthly", "nthWeekday", "wednesdayBeforeThirdSunday", "custom"] },
        "daysOfWeek": { "type": "array" },
        "weekAB": { "type": "string", "enum": ["A", "B", "both"] },
        "nth": { "type": "number" },
        "weekday": { "type": "number" },
        "customIntervalDays": { "type": "number" },
        "commitmentStatus": { "type": "string", "enum": ["confirmed", "tentative", "proposed"] },
        "source": { "type": "string", "enum": ["school", "routine", "personal", "ics-import"] },
        "isSchoolTimetable": { "type": "boolean" },
        "isRoutineMarker": { "type": "boolean" },
        "isFlexible": { "type": "boolean" },
        "durationUnconfirmed": { "type": "boolean" },
        "location": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 1000 },
        "reminderMinutes": { "type": "number" },
        "linkedHabitId": { "type": "string", "maxLength": 128 },
        "linkedMonthlyRole": { "type": "object" },
        "exceptions": { "type": "object" },
        "icsUid": { "type": "string", "maxLength": 256 }
      },
      "required": ["ownerId", "id", "title", "category", "subcategory", "startDate", "startTime", "endTime", "recurrence", "commitmentStatus", "source"]
    },
    "ActivityRecord": {
      "title": "ActivityRecord",
      "description": "Confirmed scheduled activity, timer session, or manual time log entry.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceType": { "type": "string", "enum": ["scheduled", "timer", "manual"] },
        "eventId": { "type": "string", "maxLength": 128 },
        "occurrenceDate": { "type": "string", "maxLength": 10 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "startTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "endTime": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "scheduledMinutes": { "type": "number" },
        "actualMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "partial", "skipped", "cancelled", "rescheduled"] },
        "category": { "type": "string", "enum": ["teaching", "behold", "fitness", "faith", "personal", "rest"] },
        "subcategory": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "project": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1000 },
        "isDemoData": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["ownerId", "id", "sourceType", "date", "startTime", "endTime", "actualMinutes", "status", "category", "subcategory", "title", "createdAt", "updatedAt"]
    },
    "PriorityTask": {
      "title": "PriorityTask",
      "description": "Daily priority task (up to 3 per day).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "enum": ["teaching", "behold", "fitness", "faith", "personal", "rest"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "completed": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["ownerId", "id", "title", "category", "date", "completed", "createdAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "Low-friction Atomic Habits definition with schedule, targets, cues, and archive state.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "enum": ["teaching", "behold", "fitness", "faith", "personal", "rest"] },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "custom"] },
        "weeklyTarget": { "type": "number" },
        "daysOfWeek": { "type": "array" },
        "targetMinutes": { "type": "number" },
        "targetQuantity": { "type": "number" },
        "targetUnit": { "type": "string", "maxLength": 40 },
        "cue": { "type": "string", "maxLength": 200 },
        "twoMinuteRule": { "type": "string", "maxLength": 200 },
        "stackAnchorEventId": { "type": "string", "maxLength": 128 },
        "stackAnchorLabel": { "type": "string", "maxLength": 160 },
        "stackAction": { "type": "string", "maxLength": 200 },
        "preferredWindowStart": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "preferredWindowEnd": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "linkedEventIds": { "type": "array" },
        "templateKey": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "paused": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["ownerId", "id", "title", "category", "frequency", "weeklyTarget", "paused"]
    },
    "HabitLog": {
      "title": "HabitLog",
      "description": "Daily habit completion, partial completion, skipped, excused, or two-minute starter attempt log.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "habitId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "status": { "type": "string", "enum": ["done", "partial", "skipped", "excused", "starter"] },
        "source": { "type": "string", "enum": ["manual", "calendar"] },
        "notes": { "type": "string", "maxLength": 500 },
        "actualValue": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["ownerId", "id", "habitId", "date", "status"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Life category goal with milestones and measurable output tracking.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "enum": ["teaching", "behold", "fitness", "faith", "personal", "rest"] },
        "targetDate": { "type": "string", "maxLength": 10 },
        "measurableTarget": { "type": "string", "maxLength": 200 },
        "progressMode": { "type": "string", "enum": ["milestones", "manual", "hours"] },
        "manualProgress": { "type": "number" },
        "targetHours": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed", "paused"] },
        "milestones": { "type": "array" },
        "linkedActivityKeyword": { "type": "string", "maxLength": 120 }
      },
      "required": ["ownerId", "id", "title", "description", "category", "progressMode", "manualProgress", "status", "milestones"]
    },
    "WeeklyReviewEntry": {
      "title": "WeeklyReviewEntry",
      "description": "Five-minute Sunday reflection responses keyed by week Monday.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "weekMonday": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "wentWell": { "type": "string", "maxLength": 2000 },
        "difficultOrDraining": { "type": "string", "maxLength": 2000 },
        "changeNextWeek": { "type": "string", "maxLength": 2000 },
        "savedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["ownerId", "weekMonday", "wentWell", "difficultOrDraining", "changeNextWeek", "savedAt"]
    },
    "ActiveTimerState": {
      "title": "ActiveTimerState",
      "description": "Persisted active stopwatch timer state across browser refreshes and devices.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "isRunning": { "type": "boolean" },
        "startedAtMs": { "type": "number" },
        "accumulatedMs": { "type": "number" },
        "category": { "type": "string", "enum": ["teaching", "behold", "fitness", "faith", "personal", "rest"] },
        "subcategory": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "maxLength": 200 },
        "project": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1000 },
        "linkedEventId": { "type": "string", "maxLength": 128 },
        "linkedOccurrenceDate": { "type": "string", "maxLength": 10 }
      },
      "required": ["ownerId", "id", "isRunning", "accumulatedMs", "category", "subcategory", "title", "project", "notes"]
    },
    "DevotionEntry": {
      "title": "DevotionEntry",
      "description": "Morning and evening devotional reflection entry.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "routineType": { "type": "string", "enum": ["morning", "evening"] },
        "hydrated": { "type": "boolean" },
        "watchwordsOpened": { "type": "boolean" },
        "scriptureRef": { "type": "string", "maxLength": 200 },
        "reflection": { "type": "string", "maxLength": 2000 },
        "prayerCompleted": { "type": "boolean" },
        "journalThoughts": { "type": "string", "maxLength": 2000 },
        "questions": { "type": "string", "maxLength": 1000 },
        "gratitude": { "type": "string", "maxLength": 1000 },
        "application": { "type": "string", "maxLength": 1000 },
        "shortOrMoved": { "type": "boolean" },
        "movedNote": { "type": "string", "maxLength": 500 },
        "durationMinutes": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["ownerId", "id", "date", "routineType", "scriptureRef", "reflection", "prayerCompleted", "updatedAt"]
    },
    "BibleStudyNote": {
      "title": "BibleStudyNote",
      "description": "Extended Bible study workspace note and ordered study queue.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "book": { "type": "string", "minLength": 1, "maxLength": 120 },
        "passage": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["completed", "in-progress", "upcoming"] },
        "orderIndex": { "type": "number" },
        "readingProgress": { "type": "string", "maxLength": 300 },
        "observations": { "type": "string", "maxLength": 4000 },
        "historicalContext": { "type": "string", "maxLength": 4000 },
        "theologicalInterpretation": { "type": "string", "maxLength": 4000 },
        "crossReferences": { "type": "string", "maxLength": 2000 },
        "practicalApplication": { "type": "string", "maxLength": 4000 },
        "questions": { "type": "string", "maxLength": 2000 },
        "prayerAndJournal": { "type": "string", "maxLength": 4000 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["ownerId", "id", "book", "passage", "status", "orderIndex", "readingProgress", "observations", "historicalContext", "theologicalInterpretation", "crossReferences", "practicalApplication", "questions", "prayerAndJournal", "updatedAt"]
    },
    "WorkoutSessionLog": {
      "title": "WorkoutSessionLog",
      "description": "Upper/Lower strength workout session log with exercise sets, weights, reps, and recovery notes.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sessionKey": { "type": "string", "enum": ["upper_a", "lower_a", "upper_b", "lower_b"] },
        "sessionTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "linkedEventId": { "type": "string", "maxLength": 128 },
        "durationMinutes": { "type": "number" },
        "exercises": { "type": "array" },
        "effortRpe": { "type": "number" },
        "soreness": { "type": "number" },
        "recoveryNotes": { "type": "string", "maxLength": 1000 },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["ownerId", "id", "date", "sessionKey", "sessionTitle", "durationMinutes", "exercises", "completed", "updatedAt"]
    },
    "CardioSessionLog": {
      "title": "CardioSessionLog",
      "description": "Wednesday alternating Week A endurance or Week B sprint cardio session log.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "weekType": { "type": "string", "enum": ["A", "B"] },
        "cardioType": { "type": "string", "enum": ["endurance", "sprint", "low_impact", "skipped"] },
        "durationMinutes": { "type": "number" },
        "distanceKm": { "type": "number" },
        "averagePace": { "type": "string", "maxLength": 40 },
        "sprintReps": { "type": "number" },
        "accelerationSeconds": { "type": "number" },
        "perceivedEffort": { "type": "number" },
        "recoveryQuality": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["ownerId", "id", "date", "weekType", "cardioType", "durationMinutes", "updatedAt"]
    },
    "BeholdWeekItem": {
      "title": "BeholdWeekItem",
      "description": "Behold 12-week cinematography/directing curriculum week item, shot list, and reflections.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "weekNumber": { "type": "number" },
        "monthPhase": { "type": "number" },
        "monthTitle": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "challenge": { "type": "string", "maxLength": 500 },
        "learningObjective": { "type": "string", "maxLength": 1000 },
        "technicalFocus": { "type": "string", "maxLength": 500 },
        "practicalExercise": { "type": "string", "maxLength": 1000 },
        "shotList": { "type": "array" },
        "linkedEventId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["not-started", "in-progress", "completed"] },
        "projectLink": { "type": "string", "maxLength": 400 },
        "clientProjectName": { "type": "string", "maxLength": 160 },
        "reflectionWorked": { "type": "string", "maxLength": 1500 },
        "reflectionDidntWork": { "type": "string", "maxLength": 1500 },
        "reflectionImprove": { "type": "string", "maxLength": 1500 },
        "portfolioReady": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["ownerId", "id", "weekNumber", "monthPhase", "monthTitle", "title", "challenge", "learningObjective", "technicalFocus", "practicalExercise", "shotList", "status", "projectLink", "clientProjectName", "reflectionWorked", "reflectionDidntWork", "reflectionImprove", "portfolioReady", "updatedAt"]
    },
    "FitnessConfig": {
      "title": "FitnessConfig",
      "description": "Workout plan templates, rebuild phase configuration, protein targets, and volleyball mode.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rebuildStartDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "proteinTargetMin": { "type": "number" },
        "proteinTargetMax": { "type": "number" },
        "dailyProteinLogs": { "type": "object" },
        "volleyballCompetitiveMode": { "type": "boolean" },
        "programmeReviewNotes": { "type": "string", "maxLength": 2000 },
        "lastReviewDate": { "type": "string", "maxLength": 10 },
        "workoutPlan": { "type": "array" }
      },
      "required": ["ownerId", "rebuildStartDate", "proteinTargetMin", "proteinTargetMax", "dailyProteinLogs", "volleyballCompetitiveMode", "programmeReviewNotes", "workoutPlan"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "User workspace settings and Week A/B configuration."
    },
    "/users/{userId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "User's calendar events."
    },
    "/users/{userId}/activityRecords/{recordId}": {
      "schema": { "$ref": "#/entities/ActivityRecord" },
      "description": "Confirmed scheduled activities, timer sessions, and manual time logs."
    },
    "/users/{userId}/priorities/{priorityId}": {
      "schema": { "$ref": "#/entities/PriorityTask" },
      "description": "User's daily priority tasks."
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": { "$ref": "#/entities/Habit" },
      "description": "User's habit definitions."
    },
    "/users/{userId}/habitLogs/{logId}": {
      "schema": { "$ref": "#/entities/HabitLog" },
      "description": "Daily habit completion and skip records."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "User's goals and milestones."
    },
    "/users/{userId}/weeklyReviews/{reviewId}": {
      "schema": { "$ref": "#/entities/WeeklyReviewEntry" },
      "description": "Sunday weekly reflection entries."
    },
    "/users/{userId}/devotionEntries/{entryId}": {
      "schema": { "$ref": "#/entities/DevotionEntry" },
      "description": "Morning and evening devotional logs."
    },
    "/users/{userId}/bibleStudies/{studyId}": {
      "schema": { "$ref": "#/entities/BibleStudyNote" },
      "description": "Extended Bible study notes and reading queue."
    },
    "/users/{userId}/workoutLogs/{logId}": {
      "schema": { "$ref": "#/entities/WorkoutSessionLog" },
      "description": "Logged Upper/Lower strength sessions."
    },
    "/users/{userId}/cardioLogs/{logId}": {
      "schema": { "$ref": "#/entities/CardioSessionLog" },
      "description": "Alternating endurance and sprint cardio logs."
    },
    "/users/{userId}/beholdWeeks/{weekId}": {
      "schema": { "$ref": "#/entities/BeholdWeekItem" },
      "description": "Structured creative craft week items and reflections."
    },
    "/users/{userId}/runtime/{runtimeId}": {
      "schema": { "$ref": "#/entities/ActiveTimerState" },
      "description": "Active stopwatch timer and fitnessConfig runtime state."
    }
  }
}
