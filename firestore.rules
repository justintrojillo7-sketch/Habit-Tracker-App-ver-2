      match /cardioLogs/{logId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(logId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(logId) && isOwner(userId) && isValidCardioLog(incoming(), userId, logId);
        allow update: if isValidId(logId) && isOwner(userId)
          && isValidCardioLog(incoming(), userId, logId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'weekType', 'cardioType', 'durationMinutes', 'distanceKm', 'averagePace', 'sprintReps', 'accelerationSeconds', 'perceivedEffort', 'recoveryQuality', 'notes', 'updatedAt']);
        allow delete: if isValidId(logId) && isOwner(userId);
      }

      match /beholdWeeks/{weekId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(weekId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(weekId) && isOwner(userId) && isValidBeholdWeek(incoming(), userId, weekId);
        allow update: if isValidId(weekId) && isOwner(userId)
          && isValidBeholdWeek(incoming(), userId, weekId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().diff(existing()).affectedKeys().hasOnly(['weekNumber', 'monthPhase', 'monthTitle', 'title', 'challenge', 'learningObjective', 'technicalFocus', 'practicalExercise', 'shotList', 'linkedEventId', 'status', 'projectLink', 'clientProjectName', 'reflectionWorked', 'reflectionDidntWork', 'reflectionImprove', 'portfolioReady', 'updatedAt']);
        allow delete: if isValidId(weekId) && isOwner(userId);
      }

      match /runtime/{runtimeId} {
        allow get: if (runtimeId == 'activeTimer' || runtimeId == 'fitnessConfig') && isOwner(userId);
        allow create: if isOwner(userId) && (
          (runtimeId == 'activeTimer' && isValidActiveTimer(incoming(), userId)) ||
          (runtimeId == 'fitnessConfig' && isValidFitnessConfig(incoming(), userId))
        );
        allow update: if isOwner(userId)
          && incoming().ownerId == existing().ownerId
          && (
            (runtimeId == 'activeTimer'
              && isValidActiveTimer(incoming(), userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['id', 'isRunning', 'startedAtMs', 'accumulatedMs', 'category', 'subcategory', 'title', 'project', 'notes', 'linkedEventId', 'linkedOccurrenceDate']))
            ||
            (runtimeId == 'fitnessConfig'
              && isValidFitnessConfig(incoming(), userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['rebuildStartDate', 'proteinTargetMin', 'proteinTargetMax', 'dailyProteinLogs', 'volleyballCompetitiveMode', 'programmeReviewNotes', 'lastReviewDate', 'workoutPlan']))
          );
        allow delete: if (runtimeId == 'activeTimer' || runtimeId == 'fitnessConfig') && isOwner(userId);
      }
    }
  }
