rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 180 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCategory(cat) {
      return cat in ['teaching', 'behold', 'fitness', 'faith', 'personal', 'rest'];
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTimeStr(t) {
      return t is string && t.size() == 5 && t.matches('^\\d{2}:\\d{2}$');
    }

    function isValidWorkspace(data, userId) {
      return data.keys().hasAll(['ownerId', 'theme', 'weekAnchorMonday', 'weekAnchorType', 'targetBedtime', 'notificationsEnabled', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'theme', 'weekAnchorMonday', 'weekAnchorType', 'weekOverrides', 'schoolHolidays', 'targetBedtime', 'notificationsEnabled', 'reminderOptions', 'categoryColours', 'schemaVersion', 'migrationMeta', 'updatedAt'])
        && data.ownerId == userId
        && data.theme in ['system', 'light', 'dark']
        && isValidDateStr(data.weekAnchorMonday)
        && data.weekAnchorType in ['A', 'B']
        && isValidTimeStr(data.targetBedtime)
        && data.notificationsEnabled is bool
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && (!('weekOverrides' in data) || data.weekOverrides is map)
        && (!('schoolHolidays' in data) || (data.schoolHolidays is list && data.schoolHolidays.size() <= 60))
        && (!('reminderOptions' in data) || data.reminderOptions is map)
        && (!('categoryColours' in data) || data.categoryColours is map)
        && (!('schemaVersion' in data) || (data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 100))
        && (!('migrationMeta' in data) || data.migrationMeta is map);
    }

    function isValidEvent(data, userId, eventId) {
      return data.keys().hasAll(['ownerId', 'id', 'title', 'category', 'subcategory', 'startDate', 'startTime', 'endTime', 'recurrence', 'commitmentStatus', 'source'])
        && data.keys().hasOnly(['ownerId', 'id', 'title', 'category', 'subcategory', 'startDate', 'endDate', 'startTime', 'endTime', 'recurrence', 'daysOfWeek', 'weekAB', 'nth', 'weekday', 'customIntervalDays', 'commitmentStatus', 'source', 'isSchoolTimetable', 'isRoutineMarker', 'isFlexible', 'durationUnconfirmed', 'location', 'notes', 'reminderMinutes', 'linkedHabitId', 'linkedMonthlyRole', 'exceptions', 'icsUid'])
        && data.ownerId == userId
        && data.id == eventId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && isValidCategory(data.category)
        && data.subcategory is string && data.subcategory.size() >= 1 && data.subcategory.size() <= 80
        && isValidDateStr(data.startDate)
        && (!('endDate' in data) || isValidDateStr(data.endDate))
        && isValidTimeStr(data.startTime)
        && isValidTimeStr(data.endTime)
        && data.recurrence in ['once', 'daily', 'weekly', 'fortnightly', 'monthly', 'nthWeekday', 'wednesdayBeforeThirdSunday', 'custom']
        && data.commitmentStatus in ['confirmed', 'tentative', 'proposed']
        && data.source in ['school', 'routine', 'personal', 'ics-import']
        && (!('daysOfWeek' in data) || (data.daysOfWeek is list && data.daysOfWeek.size() <= 7))
        && (!('weekAB' in data) || data.weekAB in ['A', 'B', 'both'])
        && (!('nth' in data) || (data.nth is int && data.nth >= 1 && data.nth <= 5))
        && (!('weekday' in data) || (data.weekday is int && data.weekday >= 1 && data.weekday <= 7))
        && (!('customIntervalDays' in data) || (data.customIntervalDays is int && data.customIntervalDays >= 1 && data.customIntervalDays <= 365))
        && (!('isSchoolTimetable' in data) || data.isSchoolTimetable is bool)
        && (!('isRoutineMarker' in data) || data.isRoutineMarker is bool)
        && (!('isFlexible' in data) || data.isFlexible is bool)
        && (!('durationUnconfirmed' in data) || data.durationUnconfirmed is bool)
        && (!('location' in data) || (data.location is string && data.location.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('reminderMinutes' in data) || data.reminderMinutes == null || (data.reminderMinutes is int && data.reminderMinutes >= 0 && data.reminderMinutes <= 10080))
        && (!('linkedHabitId' in data) || (data.linkedHabitId is string && data.linkedHabitId.size() <= 128))
        && (!('linkedMonthlyRole' in data) || data.linkedMonthlyRole is map)
        && (!('exceptions' in data) || data.exceptions is map)
        && (!('icsUid' in data) || (data.icsUid is string && data.icsUid.size() <= 256));
    }

    function isValidActivityRecord(data, userId, recordId) {
      return data.keys().hasAll(['ownerId', 'id', 'sourceType', 'date', 'startTime', 'endTime', 'actualMinutes', 'status', 'category', 'subcategory', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'id', 'sourceType', 'eventId', 'occurrenceDate', 'date', 'startTime', 'endTime', 'scheduledMinutes', 'actualMinutes', 'status', 'category', 'subcategory', 'title', 'project', 'notes', 'isDemoData', 'createdAt', 'updatedAt'])
        && data.ownerId == userId
        && data.id == recordId
        && data.sourceType in ['scheduled', 'timer', 'manual']
        && isValidDateStr(data.date)
        && isValidTimeStr(data.startTime)
        && isValidTimeStr(data.endTime)
        && data.actualMinutes is number && data.actualMinutes >= 0 && data.actualMinutes <= 1440
        && data.status in ['completed', 'partial', 'skipped', 'cancelled', 'rescheduled']
        && isValidCategory(data.category)
        && data.subcategory is string && data.subcategory.size() >= 1 && data.subcategory.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && (!('eventId' in data) || (data.eventId is string && data.eventId.size() <= 128))
        && (!('occurrenceDate' in data) || isValidDateStr(data.occurrenceDate))
        && (!('scheduledMinutes' in data) || (data.scheduledMinutes is number && data.scheduledMinutes >= 0 && data.scheduledMinutes <= 1440))
        && (!('project' in data) || (data.project is string && data.project.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('isDemoData' in data) || data.isDemoData is bool);
    }

    function isValidPriority(data, userId, priorityId) {
      return data.keys().hasAll(['ownerId', 'id', 'title', 'category', 'date', 'completed', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'id', 'title', 'category', 'date', 'completed', 'notes', 'createdAt'])
        && data.ownerId == userId
        && data.id == priorityId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && isValidCategory(data.category)
        && isValidDateStr(data.date)
        && data.completed is bool
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidHabit(data, userId, habitId) {
      return data.keys().hasAll(['ownerId', 'id', 'title', 'category', 'frequency', 'weeklyTarget', 'paused'])
        && data.keys().hasOnly(['ownerId', 'id', 'title', 'category', 'frequency', 'weeklyTarget', 'daysOfWeek', 'targetMinutes', 'targetQuantity', 'targetUnit', 'cue', 'twoMinuteRule', 'stackAnchorEventId', 'stackAnchorLabel', 'stackAction', 'preferredWindowStart', 'preferredWindowEnd', 'linkedEventIds', 'templateKey', 'createdAt', 'paused', 'archived', 'notes'])
        && data.ownerId == userId
        && data.id == habitId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && isValidCategory(data.category)
        && data.frequency in ['daily', 'weekly', 'custom']
        && data.weeklyTarget is int && data.weeklyTarget >= 1 && data.weeklyTarget <= 14
        && data.paused is bool
        && (!('archived' in data) || data.archived is bool)
        && (!('daysOfWeek' in data) || (data.daysOfWeek is list && data.daysOfWeek.size() <= 7 && (data.daysOfWeek.size() == 0 || data.daysOfWeek[0] is int)))
        && (!('targetMinutes' in data) || (data.targetMinutes is number && data.targetMinutes >= 1 && data.targetMinutes <= 1440))
        && (!('targetQuantity' in data) || (data.targetQuantity is number && data.targetQuantity >= 1 && data.targetQuantity <= 10000))
        && (!('targetUnit' in data) || (data.targetUnit is string && data.targetUnit.size() <= 40))
        && (!('cue' in data) || (data.cue is string && data.cue.size() <= 200))
        && (!('twoMinuteRule' in data) || (data.twoMinuteRule is string && data.twoMinuteRule.size() <= 200))
        && (!('stackAnchorEventId' in data) || (data.stackAnchorEventId is string && data.stackAnchorEventId.size() <= 128))
        && (!('stackAnchorLabel' in data) || (data.stackAnchorLabel is string && data.stackAnchorLabel.size() <= 160))
        && (!('stackAction' in data) || (data.stackAction is string && data.stackAction.size() <= 200))
        && (!('preferredWindowStart' in data) || isValidTimeStr(data.preferredWindowStart))
        && (!('preferredWindowEnd' in data) || isValidTimeStr(data.preferredWindowEnd))
        && (!('linkedEventIds' in data) || (data.linkedEventIds is list && data.linkedEventIds.size() <= 20 && (data.linkedEventIds.size() == 0 || data.linkedEventIds[0] is string)))
        && (!('templateKey' in data) || (data.templateKey is string && data.templateKey.size() <= 80))
        && (!('createdAt' in data) || isValidDateStr(data.createdAt))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidHabitLog(data, userId, logId) {
      return data.keys().hasAll(['ownerId', 'id', 'habitId', 'date', 'status'])
        && data.keys().hasOnly(['ownerId', 'id', 'habitId', 'date', 'status', 'source', 'notes', 'actualValue', 'updatedAt'])
        && data.ownerId == userId
        && data.id == logId
        && data.habitId is string && data.habitId.size() >= 1 && data.habitId.size() <= 128
        && isValidDateStr(data.date)
        && data.status in ['done', 'partial', 'skipped', 'excused', 'starter']
        && (!('source' in data) || data.source in ['manual', 'calendar'])
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('actualValue' in data) || (data.actualValue is number && data.actualValue >= 0 && data.actualValue <= 10000))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function isValidGoal(data, userId, goalId) {
      return data.keys().hasAll(['ownerId', 'id', 'title', 'description', 'category', 'progressMode', 'manualProgress', 'status', 'milestones'])
        && data.keys().hasOnly(['ownerId', 'id', 'title', 'description', 'category', 'targetDate', 'measurableTarget', 'progressMode', 'manualProgress', 'targetHours', 'status', 'milestones', 'linkedActivityKeyword'])
        && data.ownerId == userId
        && data.id == goalId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 1000
        && isValidCategory(data.category)
        && data.progressMode in ['milestones', 'manual', 'hours']
        && data.manualProgress is number && data.manualProgress >= 0 && data.manualProgress <= 100
        && data.status in ['active', 'completed', 'paused']
        && data.milestones is list && data.milestones.size() <= 30
        && (!('targetDate' in data) || isValidDateStr(data.targetDate))
        && (!('measurableTarget' in data) || (data.measurableTarget is string && data.measurableTarget.size() <= 200))
        && (!('targetHours' in data) || (data.targetHours is number && data.targetHours >= 0 && data.targetHours <= 10000))
        && (!('linkedActivityKeyword' in data) || (data.linkedActivityKeyword is string && data.linkedActivityKeyword.size() <= 120));
    }

    function isValidWeeklyReview(data, userId, reviewId) {
      return data.keys().hasAll(['ownerId', 'weekMonday', 'wentWell', 'difficultOrDraining', 'changeNextWeek', 'savedAt'])
        && data.keys().hasOnly(['ownerId', 'weekMonday', 'wentWell', 'difficultOrDraining', 'changeNextWeek', 'savedAt'])
        && data.ownerId == userId
        && data.weekMonday == reviewId
        && isValidDateStr(data.weekMonday)
        && data.wentWell is string && data.wentWell.size() <= 2000
        && data.difficultOrDraining is string && data.difficultOrDraining.size() <= 2000
        && data.changeNextWeek is string && data.changeNextWeek.size() <= 2000
        && data.savedAt is string && data.savedAt.size() <= 40;
    }

    function isValidActiveTimer(data, userId) {
      return data.keys().hasAll(['ownerId', 'id', 'isRunning', 'accumulatedMs', 'category', 'subcategory', 'title', 'project', 'notes'])
        && data.keys().hasOnly(['ownerId', 'id', 'isRunning', 'startedAtMs', 'accumulatedMs', 'category', 'subcategory', 'title', 'project', 'notes', 'linkedEventId', 'linkedOccurrenceDate'])
        && data.ownerId == userId
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128
        && data.isRunning is bool
        && (!('startedAtMs' in data) || data.startedAtMs == null || data.startedAtMs is number)
        && data.accumulatedMs is number && data.accumulatedMs >= 0
        && isValidCategory(data.category)
        && data.subcategory is string && data.subcategory.size() <= 80
        && data.title is string && data.title.size() <= 200
        && data.project is string && data.project.size() <= 120
        && data.notes is string && data.notes.size() <= 1000
        && (!('linkedEventId' in data) || (data.linkedEventId is string && data.linkedEventId.size() <= 128))
        && (!('linkedOccurrenceDate' in data) || isValidDateStr(data.linkedOccurrenceDate));
    }

    function isValidDevotionEntry(data, userId, entryId) {
      return data.keys().hasAll(['ownerId', 'id', 'date', 'routineType', 'scriptureRef', 'reflection', 'prayerCompleted', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'id', 'date', 'routineType', 'hydrated', 'watchwordsOpened', 'scriptureRef', 'reflection', 'prayerCompleted', 'journalThoughts', 'questions', 'gratitude', 'application', 'shortOrMoved', 'movedNote', 'durationMinutes', 'updatedAt'])
        && data.ownerId == userId
        && data.id == entryId
        && isValidDateStr(data.date)
        && data.routineType in ['morning', 'evening']
        && data.scriptureRef is string && data.scriptureRef.size() <= 200
        && data.reflection is string && data.reflection.size() <= 2000
        && data.prayerCompleted is bool
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && (!('hydrated' in data) || data.hydrated is bool)
        && (!('watchwordsOpened' in data) || data.watchwordsOpened is bool)
        && (!('journalThoughts' in data) || (data.journalThoughts is string && data.journalThoughts.size() <= 2000))
        && (!('questions' in data) || (data.questions is string && data.questions.size() <= 1000))
        && (!('gratitude' in data) || (data.gratitude is string && data.gratitude.size() <= 1000))
        && (!('application' in data) || (data.application is string && data.application.size() <= 1000))
        && (!('shortOrMoved' in data) || data.shortOrMoved is bool)
        && (!('movedNote' in data) || (data.movedNote is string && data.movedNote.size() <= 500))
        && (!('durationMinutes' in data) || (data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 240));
    }

    function isValidBibleStudy(data, userId, studyId) {
      return data.keys().hasAll(['ownerId', 'id', 'book', 'passage', 'status', 'orderIndex', 'readingProgress', 'observations', 'historicalContext', 'theologicalInterpretation', 'crossReferences', 'practicalApplication', 'questions', 'prayerAndJournal', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'id', 'book', 'passage', 'status', 'orderIndex', 'readingProgress', 'observations', 'historicalContext', 'theologicalInterpretation', 'crossReferences', 'practicalApplication', 'questions', 'prayerAndJournal', 'updatedAt'])
        && data.ownerId == userId
        && data.id == studyId
        && data.book is string && data.book.size() >= 1 && data.book.size() <= 120
        && data.passage is string && data.passage.size() <= 160
        && data.status in ['completed', 'in-progress', 'upcoming']
        && data.orderIndex is number && data.orderIndex >= 0 && data.orderIndex <= 500
        && data.readingProgress is string && data.readingProgress.size() <= 300
        && data.observations is string && data.observations.size() <= 4000
        && data.historicalContext is string && data.historicalContext.size() <= 4000
        && data.theologicalInterpretation is string && data.theologicalInterpretation.size() <= 4000
        && data.crossReferences is string && data.crossReferences.size() <= 2000
        && data.practicalApplication is string && data.practicalApplication.size() <= 4000
        && data.questions is string && data.questions.size() <= 2000
        && data.prayerAndJournal is string && data.prayerAndJournal.size() <= 4000
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidWorkoutLog(data, userId, logId) {
      return data.keys().hasAll(['ownerId', 'id', 'date', 'sessionKey', 'sessionTitle', 'durationMinutes', 'exercises', 'completed', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'id', 'date', 'sessionKey', 'sessionTitle', 'linkedEventId', 'durationMinutes', 'exercises', 'effortRpe', 'soreness', 'recoveryNotes', 'completed', 'updatedAt'])
        && data.ownerId == userId
        && data.id == logId
        && isValidDateStr(data.date)
        && data.sessionKey in ['upper_a', 'lower_a', 'upper_b', 'lower_b']
        && data.sessionTitle is string && data.sessionTitle.size() >= 1 && data.sessionTitle.size() <= 120
        && (!('linkedEventId' in data) || (data.linkedEventId is string && data.linkedEventId.size() <= 128))
        && data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 360
        && data.exercises is list && data.exercises.size() <= 40
        && (!('effortRpe' in data) || (data.effortRpe is number && data.effortRpe >= 1 && data.effortRpe <= 10))
        && (!('soreness' in data) || (data.soreness is number && data.soreness >= 1 && data.soreness <= 5))
        && (!('recoveryNotes' in data) || (data.recoveryNotes is string && data.recoveryNotes.size() <= 1000))
        && data.completed is bool
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidCardioLog(data, userId, logId) {
      return data.keys().hasAll(['ownerId', 'id', 'date', 'weekType', 'cardioType', 'durationMinutes', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'id', 'date', 'weekType', 'cardioType', 'durationMinutes', 'distanceKm', 'averagePace', 'sprintReps', 'accelerationSeconds', 'perceivedEffort', 'recoveryQuality', 'notes', 'updatedAt'])
        && data.ownerId == userId
        && data.id == logId
        && isValidDateStr(data.date)
        && data.weekType in ['A', 'B']
        && data.cardioType in ['endurance', 'sprint', 'low_impact', 'skipped']
        && data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 300
        && (!('distanceKm' in data) || (data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 200))
        && (!('averagePace' in data) || (data.averagePace is string && data.averagePace.size() <= 40))
        && (!('sprintReps' in data) || (data.sprintReps is number && data.sprintReps >= 0 && data.sprintReps <= 50))
        && (!('accelerationSeconds' in data) || (data.accelerationSeconds is number && data.accelerationSeconds >= 0 && data.accelerationSeconds <= 120))
        && (!('perceivedEffort' in data) || (data.perceivedEffort is number && data.perceivedEffort >= 1 && data.perceivedEffort <= 10))
        && (!('recoveryQuality' in data) || (data.recoveryQuality is string && data.recoveryQuality.size() <= 200))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidBeholdWeek(data, userId, weekId) {
      return data.keys().hasAll(['ownerId', 'id', 'weekNumber', 'monthPhase', 'monthTitle', 'title', 'challenge', 'learningObjective', 'technicalFocus', 'practicalExercise', 'shotList', 'status', 'projectLink', 'clientProjectName', 'reflectionWorked', 'reflectionDidntWork', 'reflectionImprove', 'portfolioReady', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'id', 'weekNumber', 'monthPhase', 'monthTitle', 'title', 'challenge', 'learningObjective', 'technicalFocus', 'practicalExercise', 'shotList', 'linkedEventId', 'status', 'projectLink', 'clientProjectName', 'reflectionWorked', 'reflectionDidntWork', 'reflectionImprove', 'portfolioReady', 'updatedAt'])
        && data.ownerId == userId
        && data.id == weekId
        && data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 52
        && data.monthPhase in [1, 2, 3]
        && data.monthTitle is string && data.monthTitle.size() <= 120
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.challenge is string && data.challenge.size() <= 500
        && data.learningObjective is string && data.learningObjective.size() <= 1000
        && data.technicalFocus is string && data.technicalFocus.size() <= 500
        && data.practicalExercise is string && data.practicalExercise.size() <= 1000
        && data.shotList is list && data.shotList.size() <= 50
        && (!('linkedEventId' in data) || (data.linkedEventId is string && data.linkedEventId.size() <= 128))
        && data.status in ['not-started', 'in-progress', 'completed']
        && data.projectLink is string && data.projectLink.size() <= 400
        && data.clientProjectName is string && data.clientProjectName.size() <= 160
        && data.reflectionWorked is string && data.reflectionWorked.size() <= 1500
        && data.reflectionDidntWork is string && data.reflectionDidntWork.size() <= 1500
        && data.reflectionImprove is string && data.reflectionImprove.size() <= 1500
        && data.portfolioReady is bool
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidFitnessConfig(data, userId) {
      return data.keys().hasAll(['ownerId', 'rebuildStartDate', 'proteinTargetMin', 'proteinTargetMax', 'dailyProteinLogs', 'volleyballCompetitiveMode', 'programmeReviewNotes', 'workoutPlan'])
        && data.keys().hasOnly(['ownerId', 'rebuildStartDate', 'proteinTargetMin', 'proteinTargetMax', 'dailyProteinLogs', 'volleyballCompetitiveMode', 'programmeReviewNotes', 'lastReviewDate', 'workoutPlan'])
        && data.ownerId == userId
        && isValidDateStr(data.rebuildStartDate)
        && data.proteinTargetMin is number && data.proteinTargetMin >= 0 && data.proteinTargetMin <= 400
        && data.proteinTargetMax is number && data.proteinTargetMax >= 0 && data.proteinTargetMax <= 500
        && data.dailyProteinLogs is map
        && data.volleyballCompetitiveMode is bool
        && data.programmeReviewNotes is string && data.programmeReviewNotes.size() <= 2000
        && (!('lastReviewDate' in data) || isValidDateStr(data.lastReviewDate))
        && data.workoutPlan is list && data.workoutPlan.size() <= 10;
    }

    // Connection probe document (read-only ping)
    match /test/connection {
      allow get: if true;
    }

    // User workspace root
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidWorkspace(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'weekAnchorMonday', 'weekAnchorType', 'weekOverrides', 'schoolHolidays', 'targetBedtime', 'notificationsEnabled', 'reminderOptions', 'categoryColours', 'schemaVersion', 'migrationMeta', 'updatedAt']);
      allow delete: if false;

      match /events/{eventId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(eventId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(eventId) && isOwner(userId) && isValidEvent(incoming(), userId, eventId);
        allow update: if isValidId(eventId) && isOwner(userId)
          && isValidEvent(incoming(), userId, eventId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'subcategory', 'startDate', 'endDate', 'startTime', 'endTime', 'recurrence', 'daysOfWeek', 'weekAB', 'nth', 'weekday', 'customIntervalDays', 'commitmentStatus', 'source', 'isSchoolTimetable', 'isRoutineMarker', 'isFlexible', 'durationUnconfirmed', 'location', 'notes', 'reminderMinutes', 'linkedHabitId', 'linkedMonthlyRole', 'exceptions', 'icsUid']);
        allow delete: if isValidId(eventId) && isOwner(userId);
      }

      match /activityRecords/{recordId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(recordId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(recordId) && isOwner(userId) && isValidActivityRecord(incoming(), userId, recordId);
        allow update: if isValidId(recordId) && isOwner(userId)
          && isValidActivityRecord(incoming(), userId, recordId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'startTime', 'endTime', 'scheduledMinutes', 'actualMinutes', 'status', 'category', 'subcategory', 'title', 'project', 'notes', 'updatedAt']);
        allow delete: if isValidId(recordId) && isOwner(userId);
      }

      match /priorities/{priorityId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(priorityId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(priorityId) && isOwner(userId) && isValidPriority(incoming(), userId, priorityId);
        allow update: if isValidId(priorityId) && isOwner(userId)
          && isValidPriority(incoming(), userId, priorityId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'date', 'completed', 'notes']);
        allow delete: if isValidId(priorityId) && isOwner(userId);
      }

      match /habits/{habitId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(habitId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(habitId) && isOwner(userId) && isValidHabit(incoming(), userId, habitId);
        allow update: if isValidId(habitId) && isOwner(userId)
          && isValidHabit(incoming(), userId, habitId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'frequency', 'weeklyTarget', 'daysOfWeek', 'targetMinutes', 'targetQuantity', 'targetUnit', 'cue', 'twoMinuteRule', 'stackAnchorEventId', 'stackAnchorLabel', 'stackAction', 'preferredWindowStart', 'preferredWindowEnd', 'linkedEventIds', 'templateKey', 'createdAt', 'paused', 'archived', 'notes']);
        allow delete: if isValidId(habitId) && isOwner(userId);
      }

      match /habitLogs/{logId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(logId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(logId) && isOwner(userId) && isValidHabitLog(incoming(), userId, logId);
        allow update: if isValidId(logId) && isOwner(userId)
          && isValidHabitLog(incoming(), userId, logId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'source', 'notes', 'actualValue', 'updatedAt']);
        allow delete: if isValidId(logId) && isOwner(userId);
      }

      match /goals/{goalId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(goalId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(goalId) && isOwner(userId) && isValidGoal(incoming(), userId, goalId);
        allow update: if isValidId(goalId) && isOwner(userId)
          && isValidGoal(incoming(), userId, goalId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'targetDate', 'measurableTarget', 'progressMode', 'manualProgress', 'targetHours', 'status', 'milestones', 'linkedActivityKeyword']);
        allow delete: if isValidId(goalId) && isOwner(userId);
      }

      match /weeklyReviews/{reviewId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(reviewId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(reviewId) && isOwner(userId) && isValidWeeklyReview(incoming(), userId, reviewId);
        allow update: if isValidId(reviewId) && isOwner(userId)
          && isValidWeeklyReview(incoming(), userId, reviewId)
          && incoming().ownerId == existing().ownerId
          && incoming().weekMonday == existing().weekMonday
          && incoming().diff(existing()).affectedKeys().hasOnly(['wentWell', 'difficultOrDraining', 'changeNextWeek', 'savedAt']);
        allow delete: if isValidId(reviewId) && isOwner(userId);
      }

      match /devotionEntries/{entryId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(entryId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(entryId) && isOwner(userId) && isValidDevotionEntry(incoming(), userId, entryId);
        allow update: if isValidId(entryId) && isOwner(userId)
          && isValidDevotionEntry(incoming(), userId, entryId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'routineType', 'hydrated', 'watchwordsOpened', 'scriptureRef', 'reflection', 'prayerCompleted', 'journalThoughts', 'questions', 'gratitude', 'application', 'shortOrMoved', 'movedNote', 'durationMinutes', 'updatedAt']);
        allow delete: if isValidId(entryId) && isOwner(userId);
      }

      match /bibleStudies/{studyId} {
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow get: if isValidId(studyId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(studyId) && isOwner(userId) && isValidBibleStudy(incoming(), userId, studyId);
        allow update: if isValidId(studyId) && isOwner(userId)
          && isValidBibleStudy(incoming(), userId, studyId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().diff(existing()).affectedKeys().hasOnly(['book', 'passage', 'status', 'orderIndex', 'readingProgress', 'observations', 'historicalContext', 'theologicalInterpretation', 'crossReferences', 'practicalApplication', 'questions', 'prayerAndJournal', 'updatedAt']);
        allow delete: if isValidId(studyId) && isOwner(userId);
