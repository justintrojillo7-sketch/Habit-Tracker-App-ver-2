          && incoming().id == existing().id
          && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'sessionKey', 'sessionTitle', 'linkedEventId', 'durationMinutes', 'exercises', 'effortRpe', 'soreness', 'recoveryNotes', 'completed', 'updatedAt']);
        allow delete: if isValidId(logId) && isOwner(userId);
